# ---------------------------------------------------------------------------
# Julia
# ---------------------------------------------------------------------------
# Root Manifest.toml and pluto-deployment-environment/Manifest.toml are tracked
# on purpose (reproducible course environment). Only the throwaway launcher
# environment keeps its Manifest local.
examples/launch_pluto/Manifest.toml

# ---------------------------------------------------------------------------
# Site build outputs (develop.jl / generate.jl / PlutoPages) -- the site is
# built by CI. The build no longer executes notebooks, so there is no notebook
# output cache to seed: _cache is a local leftover and must stay out.
# ---------------------------------------------------------------------------
_site/
_cache/
generation_report.html
build.log

# ---------------------------------------------------------------------------
# Generated figures (root output dir of makefigs.jl / scripts). Anchored to
# the repo root: nested figures/ dirs (e.g. examples/ProbMod/figures) and
# course/**/Figures are tracked source material.
# ---------------------------------------------------------------------------
/figures/

# ---------------------------------------------------------------------------
# LaTeX / Typst build artefacts, scoped to course/ only.
# Figures, PDFs and site assets elsewhere are tracked on purpose -- never
# blanket-ignore *.pdf / *.png / *.jpg / *.svg.
# ---------------------------------------------------------------------------
course/**/*.aux
course/**/*.log
course/**/*.out
course/**/*.toc
course/**/*.idx
course/**/*.ind
course/**/*.ilg
course/**/*.bbl
course/**/*.blg
course/**/*.fdb_latexmk
course/**/*.fls
course/**/*.synctex*
course/**/_minted*/
course/**/main.pdf
course/**/main.synctex.gz

# ---------------------------------------------------------------------------
# Private material (exams) -- never committed
# ---------------------------------------------------------------------------
examen/

# ---------------------------------------------------------------------------
# Misc (.vscode/ is tracked on purpose)
# ---------------------------------------------------------------------------
.DS_Store
*.bak
*.csv.bak

# per-run build artefact of CheckNotebooks CI (Pkg.instantiate); the env is resolved fresh
exercises/solved_notebooks/Manifest.toml
